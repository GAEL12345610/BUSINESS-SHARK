# Copia este archivo a app/.env.local y llena los valores. Nunca subas el .env.local.

# Públicas (van al navegador, es correcto): URL y anon key de Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PRIVADA: solo para funciones en app/api y scripts. JAMÁS con prefijo VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: si estas dos faltan, la app corre en MODO EJEMPLO (datos de prueba en el navegador).
